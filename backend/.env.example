# Backend configuration. Copy to `.env` and fill in real values.
# Never commit `.env`. See docs/05-environment-setup.md.

DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/codeoracle
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=sk-or-v1-replace-me
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
EMBEDDING_BATCH_SIZE=64
EMBEDDING_RETRIES=3
EMBEDDING_CACHE=true
EMBEDDING_BASE_URL=https://api.openai.com/v1
SANDBOX_IMAGE=codeoracle/sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
