# Backend configuration. Copy to `.env` and fill in real values.
# Never commit `.env`. See docs/05-environment-setup.md.

DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/codeoracle
REDIS_URL=redis://localhost:6379/0
LLM_API_KEY=replace-me
LLM_PROVIDER=openai
LLM_MODEL=
EMBEDDING_MODEL=
SANDBOX_IMAGE=codeoracle/sandbox:latest
SANDBOX_TIMEOUT_SECONDS=300
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
